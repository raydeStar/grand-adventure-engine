# Grand Adventure Engine - Environment Configuration
# Copy this file to .env and fill in your values.
# Generate unique secrets before running Docker; the Production stack rejects blanks.

# AI Narrator
# Use OpenAICompatible for LM Studio, Ollama for Ollama's native /api/chat,
# or CodexCli for a deliberately slow local Codex narration playtest.
LM_STUDIO_PROVIDER=OpenAICompatible
# Ordered providers tried when the primary fails, comma-separated. A failing provider is put on
# a short cooldown rather than retried every turn, which matters because the CodexCli adapter can
# burn its full timeout before failing. Example: CodexCli primary with a local model behind it.
LM_STUDIO_FALLBACK_PROVIDERS=
# Endpoint for the narrator API. LM Studio defaults to 1234; Ollama defaults to 11434.
LM_STUDIO_ENDPOINT=http://localhost:1234
# Model name loaded in the narrator backend. Use "default" to auto-detect.
LM_STUDIO_MODEL=default
# Optional bearer token for protected OpenAI-compatible backends such as Unsloth Studio.
LM_STUDIO_API_KEY=
# Optional request options. For Ollama, these become options.num_ctx and think.
LM_STUDIO_CONTEXT_LENGTH=
LM_STUDIO_THINK=
# CodexCli-only settings. Luna at max is high-latency and high-usage; measure it
# before considering it for everyday narration.
CODEX_EXECUTABLE=codex
CODEX_REASONING_EFFORT=max
CODEX_TIMEOUT_SECONDS=300
CODEX_WORKING_DIRECTORY=

# Discord Bot (optional - leave empty for dashboard-only mode)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# Dashboard Credentials
GAE_DASHBOARD_USER_USERNAME=user
# Required by the Production Docker stack: use different, unique values of at least 12 characters.
GAE_DASHBOARD_USER_PASSWORD=
GAE_DASHBOARD_ADMIN_USERNAME=admin
GAE_DASHBOARD_ADMIN_PASSWORD=
# Set to true only for private local demos; false keeps passwords out of anonymous login hints.
GAE_DASHBOARD_SHOW_LOGIN_PASSWORDS=false
# Login attempts allowed per source IP each minute. Ten is deliberately stingy.
GAE_AUTH_RATE_LIMIT_PER_MINUTE=10

# Network Ports
GAE_HOST_PORT=8181
POSTGRES_HOST_PORT=5432

# Database (required; do not reuse either dashboard password)
GAE_DB_PASSWORD=
